    for (var i=0;i<list.length;i++) {
      var k = list[i];
      html += '<tr><td style="padding:8px;border-bottom:1px solid #eee;font-family:monospace;">' + (k.license_key||k.key||'') + '</td><td style="padding:8px;border-bottom:1px solid #eee;">' + (k.status||'-') + '</td><td style="padding:8px;border-bottom:1px solid #eee;">' + (k.expires_at||'-') + '</td></tr>';
    }
    html += '</table>';
    document.getElementById('keysList').innerHTML = html;
  } catch(e) { showToast('Keys error: ' + e.message, 'error'); }
}
function genKey() {
  var chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789';
  var k = 'HAMSE-';
  for (var i=0;i<4;i++) { for (var j=0;j<4;j++) k += chars[Math.floor(Math.random()*chars.length)]; if (i<3) k += '-'; }
  navigator.clipboard.writeText(k);
  showToast('Key: ' + k + ' (copied)', 'success');
}

</script>
