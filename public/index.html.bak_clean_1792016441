<!-- TOAST BOX -->
<div id="toastBox"></div>

<script>
const API = window.location.origin;
let TOKEN = localStorage.getItem('hamse_token') || '';
let CURRENT_USER = JSON.parse(localStorage.getItem('hamse_user') || 'null');

// ===== TOAST =====
function showToast(msg, type='info') {
  const box = document.getElementById('toastBox');
  const t = document.createElement('div');
  t.className = 'toast ' + type;
  t.textContent = msg;
  box.appendChild(t);
  setTimeout(() => t.remove(), 3500);
}

// ===== TABS =====
function switchTab(tab) {
  document.getElementById('tabLogin').classList.toggle('active', tab === 'login');
  document.getElementById('tabRegister').classList.toggle('active', tab === 'register');
  document.getElementById('loginForm').classList.toggle('hidden', tab !== 'login');
  document.getElementById('registerForm').classList.toggle('hidden', tab !== 'register');
}

// ===== API HELPER =====
async function api(endpoint, method='GET', body=null) {
  const opts = { method, headers: { 'Content-Type': 'application/json' } };
  if (TOKEN) opts.headers['Authorization'] = 'Bearer ' + TOKEN;
  if (body) opts.body = JSON.stringify(body);
  const res = await fetch(API + endpoint, opts);
  const data = await res.json();
  if (!res.ok) throw new Error(data.error || 'Khalad dhacay');
  return data;
}

// ===== LOGIN =====
async function doLogin() {
  const username = document.getElementById('loginUsername').value.trim();
  const password = document.getElementById('loginPassword').value;
  if (!username || !password) return showToast('Username iyo password geli', 'error');
  try {
    const data = await api('/api/login', 'POST', { username, password });
    TOKEN = data.token;
    CURRENT_USER = data.user;
    localStorage.setItem('hamse_token', TOKEN);
    localStorage.setItem('hamse_user', JSON.stringify(CURRENT_USER));
    showToast('Ku soo dhawoow, ' + CURRENT_USER.fullname + '!', 'success');
    enterPanel();
  } catch (e) { showToast(e.message, 'error'); }
}

// ===== REGISTER =====
async function doRegister() {
  const fullname = document.getElementById('regFullname').value.trim();
  const username = document.getElementById('regUsername').value.trim();
  const password = document.getElementById('regPassword').value;
  const referral_code = document.getElementById('regReferral').value.trim();
  if (!username || !password || !referral_code) return showToast('Dhammaan goobaha buuxi', 'error');
  try {
    await api('/api/register', 'POST', { username, password, fullname, referral_code });
    showToast('Isdiiwaangelinta guuleystay! Hadda login samee.', 'success');
    switchTab('login');
  } catch (e) { showToast(e.message, 'error'); }
}

// ===== LOGOUT =====
function doLogout() {
  localStorage.removeItem('hamse_token');
  localStorage.removeItem('hamse_user');
  TOKEN = '';
  location.reload();
}

// ===== ENTER PANEL =====
function enterPanel() {
  document.getElementById('loginPage').classList.add('hidden');
  document.getElementById('panelPage').classList.remove('hidden');
  document.getElementById('setUsername').textContent = CURRENT_USER.username;
  document.getElementById('setRole').textContent = CURRENT_USER.role;
  document.getElementById('setRefCode').textContent = CURRENT_USER.referral_code || '-';
  showSection('dashboard');
  startClock();
}

// ===== SECTIONS =====
function showSection(name) {
  ['dashboard','users','licenses','referrals','status','settings'].forEach(s => {
    document.getElementById('section-' + s).classList.toggle('hidden', s !== name);
    document.getElementById('nav-' + s).classList.toggle('active', s === name);
  });
  const titles = { dashboard:'Dashboard', users:'Users Management', licenses:'Licenses Management', referrals:'Referrals', status:'System Status', settings:'Settings' };
  document.getElementById('pageTitle').textContent = titles[name];

  if (name === 'dashboard') loadStats();
  if (name === 'users') loadUsers();
  if (name === 'licenses') loadLicenses();
  if (name === 'referrals') loadReferrals();
  if (name === 'status') loadStatus();
}

// ===== CLOCK =====
function startClock() {
  setInterval(() => {
    const d = new Date();
    document.getElementById('liveClock').textContent = d.toLocaleTimeString('en-GB');
  }, 1000);
}

// ===== STATS =====
async function loadStats() {
  try {
    const s = await api('/api/stats');
    document.getElementById('statUsers').textContent = s.totalUsers;
    document.getElementById('statLicenses').textContent = s.totalLicenses;
    document.getElementById('statActive').textContent = s.activeLicenses;
    document.getElementById('statReferrals').textContent = s.totalReferrals;
  } catch (e) { showToast(e.message, 'error'); }
}

// ===== USERS =====
async function loadUsers() {
  try {
    const data = await api('/api/admin/users');
    const tb = document.getElementById('usersTable');
    tb.innerHTML = data.users.map(u => `
      <tr>
        <td>${u.id}</td>
        <td><b>${u.username}</b></td>
        <td>${u.fullname || '-'}</td>
        <td><span class="badge badge-${u.role}">${u.role}</span></td>
        <td><span class="badge badge-${u.status}">${u.status}</span></td>
        <td>
          <button class="btn-sm btn-primary" onclick="toggleRole(${u.id},'${u.role}')">${u.role === 'admin' ? 'User' : 'Admin'}</button>
          <button class="btn-sm btn-danger" onclick="deleteUser(${u.id})">Tirtir</button>
        </td>
      </tr>
    `).join('') || '<tr><td colspan="6" style="text-align:center;color:#6b7c93;">Ma jiro user</td></tr>';
  } catch (e) { showToast(e.message, 'error'); }
}

async function toggleRole(id, currentRole) {
  const newRole = currentRole === 'admin' ? 'user' : 'admin';
  try {
    await api('/api/admin/users/' + id, 'PUT', { role: newRole });
    showToast('Role la beddelay: ' + newRole, 'success');
    loadUsers();
  } catch (e) { showToast(e.message, 'error'); }
}

async function deleteUser(id) {
  if (!confirm('Ma hubtaa inaad tirtirto user-kan?')) return;
  try {
    await api('/api/admin/users/' + id, 'DELETE');
    showToast('User la tirtiray', 'success');
    loadUsers();
  } catch (e) { showToast(e.message, 'error'); }
}

// ===== LICENSES =====
async function loadLicenses() {
  try {
    const data = await api('/api/licenses');
    const tb = document.getElementById('licensesTable');
