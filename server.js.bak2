// ===== PAK EDITOR ROUTES =====
const multer = require('multer');
const { execFile } = require('child_process');
const os = require('os');

const pakUpload = multer({ dest: os.tmpdir() + '/pak_uploads/', limits: { fileSize: 100 * 1024 * 1024 } });
if (!fs.existsSync(os.tmpdir() + '/pak_uploads/')) fs.mkdirSync(os.tmpdir() + '/pak_uploads/', { recursive: true });

app.post('/api/pak/inject', authMiddleware, adminMiddleware, pakUpload.fields([
  { name: 'pak', maxCount: 1 }, { name: 'bypass', maxCount: 1 }
]), (req, res) => {
  try {
    if (!req.files || !req.files.pak || !req.files.bypass) {
      return res.status(400).json({ status: 'error', msg: 'pak and bypass files required' });
    }
    const pakPath = req.files.pak[0].path;
    const bypassPath = req.files.bypass[0].path;
    const outPath = os.tmpdir() + '/pak_out_' + Date.now() + '.pak';
    const script = path.join(__dirname, 'pak_editor', 'inject.py');
    execFile('python3', [script, pakPath, bypassPath, outPath], { timeout: 120000 }, (err, stdout, stderr) => {
      try { fs.unlinkSync(pakPath); } catch(e){}
      try { fs.unlinkSync(bypassPath); } catch(e){}
      if (err) return res.status(500).json({ status: 'error', msg: err.message, stderr: stderr });
      let result;
      try { result = JSON.parse(stdout.trim()); } catch(e) { return res.status(500).json({ status: 'error', msg: 'invalid output', raw: stdout }); }
      if (result.status !== 'ok') return res.status(400).json(result);
      const id = path.basename(outPath);
      res.json({ ...result, download_id: id });
    });
  } catch (e) {
    res.status(500).json({ status: 'error', msg: e.message });
  }
});

app.get('/api/pak/download-temp/:id', authMiddleware, adminMiddleware, (req, res) => {
  const id = path.basename(req.params.id);
  const file = os.tmpdir() + '/' + id;
  if (!fs.existsSync(file)) return res.status(404).json({ status: 'error', msg: 'not found' });
  res.download(file, 'modified_' + id);
});


// ===== LOADER MANAGER ROUTES =====
const LOADER_DIR = path.join(__dirname, 'loader_files');
if (!fs.existsSync(LOADER_DIR)) fs.mkdirSync(LOADER_DIR, { recursive: true });

const loaderUpload = multer({ dest: LOADER_DIR, limits: { fileSize: 200 * 1024 * 1024 } });

app.post('/api/loader/upload', authMiddleware, adminMiddleware, loaderUpload.fields([
  { name: 'apk', maxCount: 1 }
]), (req, res) => {
  if (!req.files || !req.files.apk) return res.status(400).json({ status: 'error', msg: 'apk required' });
  const f = req.files.apk[0];
  const target = path.join(LOADER_DIR, 'Hamse_cheats_vip_loader_' + Date.now() + '.apk');
  fs.renameSync(f.path, target);
  const meta = { name: path.basename(target), size: fs.statSync(target).size, uploaded: new Date().toISOString() };
  fs.writeFileSync(path.join(LOADER_DIR, 'loader_meta.json'), JSON.stringify(meta, null, 2));
  res.json({ status: 'ok', ...meta });
});

app.get('/api/loader/current', authMiddleware, adminMiddleware, (req, res) => {
  const metaPath = path.join(LOADER_DIR, 'loader_meta.json');
  if (!fs.existsSync(metaPath)) return res.json({ status: 'none', msg: 'no loader uploaded' });
  const meta = JSON.parse(fs.readFileSync(metaPath, 'utf8'));
  res.json({ status: 'ok', ...meta });
});

app.get('/api/loader/download', authMiddleware, adminMiddleware, (req, res) => {
  const metaPath = path.join(LOADER_DIR, 'loader_meta.json');
  if (!fs.existsSync(metaPath)) return res.status(404).json({ status: 'error', msg: 'no loader' });
  const meta = JSON.parse(fs.readFileSync(metaPath, 'utf8'));
  res.download(path.join(LOADER_DIR, meta.name), meta.name);
});

app.get('/api/loader/check-update', (req, res) => {
  const metaPath = path.join(LOADER_DIR, 'loader_meta.json');
  if (!fs.existsSync(metaPath)) return res.json({ status: 'none' });
  const meta = JSON.parse(fs.readFileSync(metaPath, 'utf8'));
  res.json({ status: 'ok', version: meta.uploaded, size: meta.size, download_url: '/api/loader/download' });
});


// ===== PAK UPDATE ROUTES =====
const PAK_DIR_OUT = path.join(__dirname, 'pak_editor', 'output');
if (!fs.existsSync(PAK_DIR_OUT)) fs.mkdirSync(PAK_DIR_OUT, { recursive: true });

app.get('/api/pak/check-update', (req, res) => {
  const files = fs.readdirSync(PAK_DIR_OUT).filter(f => f.endsWith('.pak'));
  if (!files.length) return res.json({ status: 'none' });
  const latest = files.sort().pop();
  const fp = path.join(PAK_DIR_OUT, latest);
  const stat = fs.statSync(fp);
  const buf = fs.readFileSync(fp);
  const sha256 = crypto.createHash('sha256').update(buf).digest('hex');
  const versionMatch = latest.match(/_(\d+\.\d+\.\d+\.\d+)\.pak$/);
  const version = versionMatch ? versionMatch[1] : '4.6.0.21572';
  res.json({
    status: 'ok',
    name: latest,
    version: version,
    size: stat.size,
    sha256: sha256,
    mtime: stat.mtime,
    download_url: '/api/pak/download/' + latest
  });
});

app.get('/api/pak/download/pak*', (req, res) => {
  const files = fs.readdirSync(PAK_DIR_OUT).filter(f => f.endsWith('.pak'));
  if (!files.length) return res.status(404).json({ status: 'error', msg: 'no pak' });
app.get('/api/pak/download/:name', (req, res) => {
  const name = path.basename(req.params.name);
  const file = path.join(PAK_DIR_OUT, name);
  if (!fs.existsSync(file)) return res.status(404).json({ status: 'error', msg: 'not found' });
  res.download(file, name);
});


/* ===================== ADD APPS / LOADER MANAGER ===================== */
const APPS_DIR = path.join(__dirname, "apps_store");
if (!fs.existsSync(APPS_DIR)) fs.mkdirSync(APPS_DIR, { recursive: true });

// ensure tables
try {
  db.run(`CREATE TABLE IF NOT EXISTS apps (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    name TEXT NOT NULL,
    package_name TEXT,
    version TEXT,
    size INTEGER DEFAULT 0,
    filename TEXT NOT NULL,
    display_name TEXT,
    branding TEXT,
    icon_path TEXT,
    logo_path TEXT,
    config_json TEXT DEFAULT '{}',
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP
  )`);
  db.run(`CREATE TABLE IF NOT EXISTS app_assets (
    id INTEGER PRIMARY KEY AUTOINCREMENT,
    app_id INTEGER NOT NULL,
    kind TEXT NOT NULL,
    filename TEXT NOT NULL,
    created_at DATETIME DEFAULT CURRENT_TIMESTAMP
  )`);
  if (typeof saveDB === "function") saveDB();
} catch (e) { console.log("apps tables: " + e.message); }

const appsStorage = multer.diskStorage({
  destination: function (req, file, cb) { cb(null, APPS_DIR); },
  filename: function (req, file, cb) {
    const safe = (file.originalname || "app.apk").replace(/[^A-Za-z0-9._-]/g, "_");
    cb(null, Date.now() + "_" + safe);
  }
});
const appsUpload = multer({
  storage: appsStorage,
  limits: { fileSize: 300 * 1024 * 1024 },
  fileFilter: function (req, file, cb) {
    if (!/\.(apk|zip|png|jpg|jpeg|webp)$/i.test(file.originalname)) return cb(new Error("bad file type"));
    cb(null, true);
  }
});

app.post("/api/apps/upload", authMiddleware, adminMiddleware, appsUpload.single("apk"), function (req, res) {
  try {
    if (!req.file) return res.status(400).json({ status: "error", msg: "apk required" });
    const original = req.file.originalname || "app.apk";
    const base = original.replace(/\.apk$/i, "");
    const info = { name: base, package_name: null, version: null, size: req.file.size };
    db.run("INSERT INTO apps (name, package_name, version, size, filename) VALUES (?,?,?,?,?)",
      [info.name, info.package_name, info.version, info.size, req.file.filename]);
    if (typeof saveDB === "function") saveDB();
    const row = db.exec("SELECT * FROM apps ORDER BY id DESC LIMIT 1");
    res.json({ status: "ok", app: row[0] ? row[0].values[0] : null });
  } catch (e) { res.status(500).json({ status: "error", msg: e.message }); }
});

app.get("/api/apps/list", authMiddleware, adminMiddleware, function (req, res) {
  try {
    const r = db.exec("SELECT id,name,package_name,version,size,filename,display_name,branding,icon_path,logo_path,config_json,created_at FROM apps ORDER BY id DESC");
    res.json({ status: "ok", apps: r[0] ? r[0].values.map(function (v) {
      return { id:v[0], name:v[1], package_name:v[2], version:v[3], size:v[4], filename:v[5],
               display_name:v[6], branding:v[7], icon_path:v[8], logo_path:v[9],
               config: (function(){ try { return JSON.parse(v[10]||"{}"); } catch(e){ return {}; } })(), created_at:v[11] };
    }) : [] });
  } catch (e) { res.status(500).json({ status: "error", msg: e.message }); }
});

app.get("/api/apps/:id", authMiddleware, adminMiddleware, function (req, res) {
  try {
    const id = parseInt(req.params.id, 10);
    const r = db.exec("SELECT * FROM apps WHERE id = " + id);
    if (!r[0] || !r[0].values.length) return res.status(404).json({ status: "error", msg: "not found" });
    const v = r[0].values[0];
    res.json({ status: "ok", app: { id:v[0], name:v[1], package_name:v[2], version:v[3], size:v[4], filename:v[5],
      display_name:v[6], branding:v[7], icon_path:v[8], logo_path:v[9],
      config: (function(){ try { return JSON.parse(v[10]||"{}"); } catch(e){ return {}; } })(), created_at:v[11] } });
  } catch (e) { res.status(500).json({ status: "error", msg: e.message }); }
});

app.put("/api/apps/:id/config", authMiddleware, adminMiddleware, function (req, res) {
  try {
    const id = parseInt(req.params.id, 10);
    const b = req.body || {};
    const cfg = JSON.stringify(b.config || {});
    db.run("UPDATE apps SET display_name = ?, branding = ?, config_json = ? WHERE id = ?",
      [b.display_name || null, b.branding || null, cfg, id]);
    if (typeof saveDB === "function") saveDB();
    res.json({ status: "ok" });
  } catch (e) { res.status(500).json({ status: "error", msg: e.message }); }
});

app.post("/api/apps/:id/asset", authMiddleware, adminMiddleware, appsUpload.single("asset"), function (req, res) {
  try {
    if (!req.file) return res.status(400).json({ status: "error", msg: "asset required" });
    const id = parseInt(req.params.id, 10);
    const kind = (req.body && req.body.kind) ? String(req.body.kind) : "asset";
    db.run("INSERT INTO app_assets (app_id, kind, filename) VALUES (?,?,?)", [id, kind, req.file.filename]);
    if (kind === "icon") db.run("UPDATE apps SET icon_path = ? WHERE id = ?", [req.file.filename, id]);
    if (kind === "logo") db.run("UPDATE apps SET logo_path = ? WHERE id = ?", [req.file.filename, id]);
    if (typeof saveDB === "function") saveDB();
    res.json({ status: "ok", filename: req.file.filename, kind: kind });
  } catch (e) { res.status(500).json({ status: "error", msg: e.message }); }
});

app.delete("/api/apps/:id", authMiddleware, adminMiddleware, function (req, res) {
  try {
    const id = parseInt(req.params.id, 10);
    const r = db.exec("SELECT filename, icon_path, logo_path FROM apps WHERE id = " + id);
    if (r[0] && r[0].values.length) {
      const v = r[0].values[0];
      [v[0], v[1], v[2]].forEach(function (fn) {
        if (fn) { try { fs.unlinkSync(path.join(APPS_DIR, fn)); } catch (e) {} }
      });
    }
    const assets = db.exec("SELECT filename FROM app_assets WHERE app_id = " + id);
    if (assets[0]) assets[0].values.forEach(function (row) {
      try { fs.unlinkSync(path.join(APPS_DIR, row[0])); } catch (e) {}
    });
    db.run("DELETE FROM app_assets WHERE app_id = " + id);
    db.run("DELETE FROM apps WHERE id = " + id);
    if (typeof saveDB === "function") saveDB();
    res.json({ status: "ok" });
  } catch (e) { res.status(500).json({ status: "error", msg: e.message }); }
});

app.get("/api/apps/:id/download", function (req, res) {
  try {
    const id = parseInt(req.params.id, 10);
    const r = db.exec("SELECT filename, name FROM apps WHERE id = " + id);
    if (!r[0] || !r[0].values.length) return res.status(404).send("not found");
    const file = path.join(APPS_DIR, r[0].values[0][0]);
    if (!fs.existsSync(file)) return res.status(404).send("file missing");
    res.download(file, r[0].values[0][1] + ".apk");
  } catch (e) { res.status(500).send(e.message); }
});


app.get('/api/pak/list', authMiddleware, adminMiddleware, (req, res) => {
  const files = fs.readdirSync(PAK_DIR_OUT).filter(f => f.endsWith('.pak'));
  res.json({ status: 'ok', files: files.map(f => ({ name: f, size: fs.statSync(path.join(PAK_DIR_OUT, f)).size })) });
});


// ===== DB BACKUP TO GIST =====
app.post('/api/db/backup', authMiddleware, adminMiddleware, async (req, res) => {
  try {
    const b64 = Buffer.from(db.export()).toString('base64');
    const ghToken = process.env.GITHUB_TOKEN;
    const gistId = process.env.GIST_ID;
    if (!ghToken || !gistId) return res.status(400).json({ error: 'GITHUB_TOKEN or GIST_ID missing' });
    const r = await fetch('https://api.github.com/gists/' + gistId, {
      method: 'PATCH',
      headers: { 'Authorization': 'token ' + ghToken, 'Content-Type': 'application/json' },
      body: JSON.stringify({ files: { 'hamse_vip.db.b64': { content: b64 } } })
    });
    const j = await r.json();
    res.json({ success: true, updated_at: j.updated_at, size: b64.length });
  } catch(e) { res.status(500).json({ error: e.message }); }
});

app.post('/api/db/restore', authMiddleware, adminMiddleware, async (req, res) => {
  try {
    const ghToken = process.env.GITHUB_TOKEN;
    const gistId = process.env.GIST_ID;
    if (!ghToken || !gistId) return res.status(400).json({ error: 'GITHUB_TOKEN or GIST_ID missing' });
    const r = await fetch('https://api.github.com/gists/' + gistId, {
      headers: { 'Authorization': 'token ' + ghToken }
    });
    const j = await r.json();
    if (!j.files || !j.files['hamse_vip.db.b64']) return res.status(404).json({ error: 'No backup found' });
    const b64 = j.files['hamse_vip.db.b64'].content;
    const buf = Buffer.from(b64, 'base64');
    db = new SQL.Database(buf);
    saveDB();
    res.json({ success: true, size: buf.length });
  } catch(e) { res.status(500).json({ error: e.message }); }
});

setInterval(() => {
  if (process.env.GITHUB_TOKEN && process.env.GIST_ID) {
    (async () => {
      try {
        const b64 = Buffer.from(db.export()).toString('base64');
        await fetch('https://api.github.com/gists/' + process.env.GIST_ID, {
          method: 'PATCH',
          headers: { 'Authorization': 'token ' + process.env.GITHUB_TOKEN, 'Content-Type': 'application/json' },
          body: JSON.stringify({ files: { 'hamse_vip.db.b64': { content: b64 } } })
        });
        console.log('DB auto-backed up to Gist');
      } catch(e) { console.log('Gist backup error:', e.message); }
    })();
  }
}, 5 * 60 * 1000);


app.get('/api/pak', (req, res) => {
  const files = fs.readdirSync(PAK_DIR_OUT).filter(f => f.endsWith('.pak'));
  if (!files.length) return res.json({ status: 'none' });
  const latest = files.sort().pop();
  const fp = path.join(PAK_DIR_OUT, latest);
  const stat = fs.statSync(fp);
  const sha256 = crypto.createHash('sha256').update(fs.readFileSync(fp)).digest('hex');
  res.json({
    status: 'ok',
    name: latest,
    version: '4.6.0.21572',
    size: stat.size,
    sha256: sha256,
    download_url: '/api/pak/download/' + latest
  });
});



app.get("/api/github/releases", authMiddleware, adminMiddleware, async (req, res) => {
  try {
    const r = await fetch("https://api.github.com/repos/uchihaaymane/files/releases", {
      headers: { "User-Agent": "HamsePanel" }
    });
    const data = await r.json();
    if (!Array.isArray(data)) return res.json({ success: false, error: "Invalid response" });
    const releases = data.map(rel => ({
      tag: rel.tag_name,
      name: rel.name,
      published: rel.published_at,
      html_url: rel.html_url,
      assets: rel.assets.map(a => ({
        name: a.name,
        size: a.size,
        download_count: a.download_count,
        updated_at: a.updated_at,
        browser_download_url: a.browser_download_url
      }))
    }));
    res.json({ success: true, releases: releases });
  } catch(e) {
    res.status(500).json({ success: false, error: e.message });
  }
});

app.get('*', (req, res) => res.sendFile(path.join(__dirname, 'public', 'index.html')));

