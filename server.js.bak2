app.put('/api/admin/licenses/:id/edit', authMiddleware, adminMiddleware, (req, res) => {
  const max_devices = parseInt(req.body.max_devices);
  if (!max_devices || max_devices < 1) return res.status(400).json({ success: false, error: 'max_devices waa inuu ka weyn yahay 0' });
  try {
    db.run('UPDATE licenses SET max_devices = ? WHERE id = ?', [max_devices, req.params.id]);
    saveDB();
    res.json({ success: true, message: 'Max devices la beddelay' });
  } catch(e) {
    res.status(500).json({ success: false, error: e.message });
  }
});

app.put('/api/admin/licenses/:id/update', authMiddleware, adminMiddleware, (req, res) => {
  try {
    const id = req.params.id;
    const b = req.body || {};
    const row = queryAll('SELECT * FROM licenses WHERE id = ?', [id])[0];
    if (!row) return res.status(404).json({ success: false, error: 'License not found' });
    if (b.status !== undefined) {
      if (['active', 'disabled', 'unused'].indexOf(b.status) === -1) return res.status(400).json({ success: false, error: 'Invalid status' });
      db.run('UPDATE licenses SET status = ? WHERE id = ?', [b.status, id]);
    }
    if (b.max_devices !== undefined) {
      const md = parseInt(b.max_devices);
      if (!md || md < 1 || md > 1000) return res.status(400).json({ success: false, error: 'max_devices must be 1-1000' });
      db.run('UPDATE licenses SET max_devices = ? WHERE id = ?', [md, id]);
    }
    if (b.add_minutes !== undefined) {
      const m = parseInt(b.add_minutes);
      if (isNaN(m)) return res.status(400).json({ success: false, error: 'Invalid minutes' });
      const base = new Date(String(row.expires_at).replace(' ', 'T') + 'Z');
      const next = new Date(base.getTime() + m * 60000).toISOString().replace('T', ' ').substring(0, 19);
      db.run('UPDATE licenses SET expires_at = ? WHERE id = ?', [next, id]);
    }
    saveDB();
    res.json({ success: true, message: 'License updated' });
  } catch (e) {
    res.status(500).json({ success: false, error: e.message });
  }
});

app.delete('/api/admin/licenses/:id', authMiddleware, adminMiddleware, (req, res) => {
